class DashboardPage extends StatelessWidget {
  final List<Scholarship> scholarships;
  final StudentProfile profile;
  final OpenCallback onOpen;
  final VoidCallback onViewDeadlines;
  final VoidCallback onViewScholarships;
  final VoidCallback onViewApplications;

  const DashboardPage({
    super.key,
    required this.scholarships,
    required this.profile,
    required this.onOpen,
    required this.onViewDeadlines,
    required this.onViewScholarships,
    required this.onViewApplications,
  });

  @override
  Widget build(BuildContext context) {
    // Statistics are calculated from the live list, so they update dynamically.
    final total = scholarships.length;
    final applied = scholarships
        .where((s) => s.status != ApplicationStatus.notApplied)
        .length;
    final pending = scholarships
        .where((s) =>
            s.status == ApplicationStatus.applied ||
            s.status == ApplicationStatus.underReview)
        .length;
    final approved = scholarships
        .where((s) => s.status == ApplicationStatus.approved)
        .length;
    final expiredCount = scholarships.where((s) => s.isExpired).length;

    // Next deadlines (not expired), soonest first.
    final upcoming = scholarships.where((s) => !s.isExpired).toList()
      ..sort((a, b) => a.deadline.compareTo(b.deadline));

    final firstName = profile.name.trim().split(' ').first;

    final cards = <StatCard>[
      StatCard(
        label: 'Total Scholarships',
        value: total,
        icon: Icons.school_rounded,
        color: kBlue,
        onTap: onViewScholarships,
      ),
      StatCard(
        label: 'Applied',
        value: applied,
        icon: Icons.send_rounded,
        color: kPurple,
        onTap: onViewApplications,
      ),
      StatCard(
        label: 'Pending',
        value: pending,
        icon: Icons.hourglass_top_rounded,
        color: kAmber,
        onTap: onViewApplications,
      ),
      StatCard(
        label: 'Approved',
        value: approved,
        icon: Icons.check_circle_rounded,
        color: kGreen,
        onTap: onViewApplications,
      ),
    ];

    return ListView(
      padding: const EdgeInsets.all(16),
      children: [
        // Welcome banner
        Container(
          padding: const EdgeInsets.all(20),
          decoration: BoxDecoration(
            gradient: const LinearGradient(
              colors: [kBlue, kPurple],
              begin: Alignment.topLeft,
              end: Alignment.bottomRight,
            ),
            borderRadius: BorderRadius.circular(24),
            boxShadow: const [
              BoxShadow(
                color: Color(0x442563EB),
                blurRadius: 16,
                offset: Offset(0, 6),
              ),
            ],
          ),
          child: Row(
            children: [
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    const Text(
                      'Scholarship Tracker',
                      style: TextStyle(
                        color: Colors.white70,
                        fontSize: 13,
                        fontWeight: FontWeight.w600,
                        letterSpacing: 0.5,
                      ),
                    ),
                    const SizedBox(height: 6),
                    Text(
                      'Welcome back, $firstName!',
                      style: const TextStyle(
                        color: Colors.white,
                        fontSize: 24,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                    const SizedBox(height: 6),
                    const Text(
                      'Discover scholarships, track your applications and never miss a deadline.',
                      style: TextStyle(color: Colors.white, fontSize: 13.5),
                    ),
                  ],
                ),
              ),
              const SizedBox(width: 12),
              Icon(
                Icons.school_rounded,
                size: 56,
                color: Colors.white.withAlpha(110),
              ),
            ],
          ),
        ),
        const SizedBox(height: 20),

        // Statistic cards (2 columns on phones, 4 on wider screens)
        LayoutBuilder(
          builder: (context, constraints) {
            final columns = constraints.maxWidth >= 600 ? 4 : 2;
            const gap = 12.0;
            final itemWidth =
                (constraints.maxWidth - gap * (columns - 1)) / columns;
            return Wrap(
              spacing: gap,
              runSpacing: gap,
              children: [
                for (final c in cards) SizedBox(width: itemWidth, child: c),
              ],
            );
          },
        ),
        const SizedBox(height: 24),

        // Upcoming deadlines
        SectionHeader(
          title: 'Upcoming Deadlines',
          actionLabel: 'View all',
          onAction: onViewDeadlines,
        ),
        const SizedBox(height: 8),
        if (upcoming.isEmpty)
          const Padding(
            padding: EdgeInsets.symmetric(vertical: 24),
            child: Text(
              'No upcoming deadlines right now.',
              textAlign: TextAlign.center,
              style: TextStyle(color: kTextGrey),
            ),
          )
        else
          for (final s in upcoming.take(4))
            DeadlineTile(scholarship: s, onTap: () => onOpen(s)),
        if (expiredCount > 0)
          Padding(
            padding: const EdgeInsets.only(top: 4),
            child: Text(
              '$expiredCount expired scholarship${expiredCount == 1 ? '' : 's'} – tap "View all" to see them.',
              style: const TextStyle(fontSize: 12.5, color: kTextGrey),
            ),
          ),
      ],
    );
  }
}

