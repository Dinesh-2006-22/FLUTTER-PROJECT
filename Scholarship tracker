class HomeShell extends StatefulWidget {
  const HomeShell({super.key});

  @override
  State<HomeShell> createState() => _HomeShellState();
}

class _HomeShellState extends State<HomeShell> {
  int _index = 0;

  // In-memory "database"
  final List<Scholarship> _scholarships = buildSampleScholarships();
  StudentProfile _profile = StudentProfile(
    name: 'Aarav Sharma',
    email: 'aarav.sharma@example.com',
    course: 'B.Tech Computer Science',
    college: 'Greenfield Institute of Technology',
    year: '2nd Year',
  );

  static const List<String> _titles = [
    'Dashboard',
    'Scholarships',
    'My Applications',
    'Profile',
  ];

  /// Updates the status of a scholarship and refreshes every screen.
  void _updateStatus(Scholarship s, ApplicationStatus status) {
    setState(() => s.status = status);
  }

  /// Opens the details page for a scholarship.
  Future<void> _openDetails(Scholarship s) async {
    await Navigator.of(context).push<void>(
      MaterialPageRoute<void>(
        builder: (_) => ScholarshipDetailPage(
          scholarship: s,
          onStatusChanged: _updateStatus,
        ),
      ),
    );
  }

  /// Opens the full deadline management page.
  void _openDeadlines() {
    Navigator.of(context).push<void>(
      MaterialPageRoute<void>(
        builder: (_) => DeadlinesPage(
          scholarships: _scholarships,
          onOpen: _openDetails,
        ),
      ),
    );
  }

  void _goTo(int index) => setState(() => _index = index);

  @override
  Widget build(BuildContext context) {
    final pages = <Widget>[
      DashboardPage(
        scholarships: _scholarships,
        profile: _profile,
        onOpen: _openDetails,
        onViewDeadlines: _openDeadlines,
        onViewScholarships: () => _goTo(1),
        onViewApplications: () => _goTo(2),
      ),
      ScholarshipsPage(
        scholarships: _scholarships,
        onOpen: _openDetails,
      ),
      ApplicationsPage(
        scholarships: _scholarships,
        onOpen: _openDetails,
        onStatusChanged: _updateStatus,
        onBrowse: () => _goTo(1),
      ),
      ProfilePage(
        profile: _profile,
        onSave: (p) => setState(() => _profile = p),
      ),
    ];

    return Scaffold(
      appBar: AppBar(
        title: Text(_titles[_index]),
        actions: [
          IconButton(
            tooltip: 'All deadlines',
            icon: const Icon(Icons.event_note_rounded, color: kBlue),
            onPressed: _openDeadlines,
          ),
          const SizedBox(width: 4),
        ],
      ),
      // Content is centered with a max width so it looks good on desktop too.
      body: Center(
        child: ConstrainedBox(
          constraints: const BoxConstraints(maxWidth: 900),
          child: IndexedStack(
            index: _index,
            sizing: StackFit.expand,
            children: pages,
          ),
        ),
      ),
      bottomNavigationBar: NavigationBar(
        selectedIndex: _index,
        onDestinationSelected: _goTo,
        destinations: const [
          NavigationDestination(
            icon: Icon(Icons.dashboard_outlined),
            selectedIcon: Icon(Icons.dashboard, color: kBlue),
            label: 'Dashboard',
          ),
          NavigationDestination(
            icon: Icon(Icons.school_outlined),
            selectedIcon: Icon(Icons.school, color: kBlue),
            label: 'Scholarships',
          ),
          NavigationDestination(
            icon: Icon(Icons.assignment_outlined),
            selectedIcon: Icon(Icons.assignment, color: kBlue),
            label: 'My Applications',
          ),
          NavigationDestination(
            icon: Icon(Icons.person_outline),
            selectedIcon: Icon(Icons.person, color: kBlue),
            label: 'Profile',
          ),
