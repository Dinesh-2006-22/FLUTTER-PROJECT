String formatDate(DateTime d) => '${d.day} ${kMonths[d.month - 1]} ${d.year}';

/// Formats 50000 as ₹50,000
String formatAmount(int amount) {
  final s = amount.toString();
  final buffer = StringBuffer();
  for (int i = 0; i < s.length; i++) {
    if (i > 0 && (s.length - i) % 3 == 0) buffer.write(',');
    buffer.write(s[i]);
  }
  return '₹$buffer';
}

String deadlineText(Scholarship s) {
  final d = s.daysLeft;
  if (d < 0) {
    final ago = -d;
    final unit = ago == 1 ? 'day' : 'days';
    return 'Expired $ago $unit ago';
  }
  if (d == 0) return 'Due today';
  if (d == 1) return '1 day left';
  return '$d days left';
}

/// Color changes with urgency: grey (expired), red, orange, green.
Color deadlineColor(Scholarship s) {
  final d = s.daysLeft;
  if (d < 0) return kTextGrey;
  if (d <= 3) return kRed;
  if (d <= 7) return kOrange;
  return kGreen;
}

IconData categoryIcon(String category) {
  switch (category) {
    case 'Merit':
      return Icons.emoji_events_rounded;
    case 'Need-Based':
      return Icons.favorite_rounded;
    case 'STEM':
      return Icons.science_rounded;
    case 'Sports':
      return Icons.sports_soccer_rounded;
    case 'Minority':
      return Icons.groups_rounded;
    case 'Research':
      return Icons.menu_book_rounded;
    default:
      return Icons.school_rounded;
  }
}

String initialsOf(String name) {
  final parts =
      name.trim().split(RegExp(r'\s+')).where((p) => p.isNotEmpty).toList();
  if (parts.isEmpty) return '?';
  if (parts.length == 1) return parts[0][0].toUpperCase();
  return (parts.first[0] + parts.last[0]).toUpperCase();
}

