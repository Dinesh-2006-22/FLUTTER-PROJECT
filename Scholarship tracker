class DeadlinesPage extends StatefulWidget {
  final List<Scholarship> scholarships;
  final OpenCallback onOpen;

  const DeadlinesPage({
    super.key,
    required this.scholarships,
    required this.onOpen,
  });

  @override
  State<DeadlinesPage> createState() => _DeadlinesPageState();
}

class _DeadlinesPageState extends State<DeadlinesPage> {
  Future<void> _open(Scholarship s) async {
    await widget.onOpen(s);
    if (mounted) setState(() {});
  }

  /// Builds a titled group of deadline tiles.
  List<Widget> _section({
    required String title,
    required String subtitle,
    required IconData icon,
    required Color color,
    required List<Scholarship> items,
  }) {
    if (items.isEmpty) return <Widget>[];
    return <Widget>[
      Padding(
        padding: const EdgeInsets.only(top: 8, bottom: 12),
        child: Row(
          children: [
            Icon(icon, color: color),
            const SizedBox(width: 8),
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    title,
                    style: const TextStyle(
                      fontSize: 17,
                      fontWeight: FontWeight.bold,
                      color: kTextDark,
                    ),
                  ),
                  Text(
                    subtitle,
                    style: const TextStyle(fontSize: 12, color: kTextGrey),
                  ),
                ],
              ),
            ),
            Pill(text: '${items.length}', color: color),
          ],
        ),
      ),
      for (final s in items)
        DeadlineTile(scholarship: s, onTap: () => _open(s)),
      const SizedBox(height: 8),
    ];
  }

  @override
  Widget build(BuildContext context) {
    final all = widget.scholarships;

    final approaching = all.where((s) => s.isApproaching).toList()
      ..sort((a, b) => a.deadline.compareTo(b.deadline));
    final upcoming =
        all.where((s) => !s.isExpired && !s.isApproaching).toList()
          ..sort((a, b) => a.deadline.compareTo(b.deadline));
    final expired = all.where((s) => s.isExpired).toList()
      ..sort((a, b) => b.deadline.compareTo(a.deadline));

    return Scaffold(
      appBar: AppBar(title: const Text('Deadlines')),
      body: Center(
        child: ConstrainedBox(
          constraints: const BoxConstraints(maxWidth: 800),
          child: ListView(
            padding: const EdgeInsets.all(16),
            children: [
              ..._section(
                title: 'Approaching Soon',
                subtitle: 'Due within the next 7 days',
                icon: Icons.warning_amber_rounded,
                color: kOrange,
                items: approaching,
              ),
              ..._section(
                title: 'Upcoming',
                subtitle: 'More than a week left',
                icon: Icons.event_available_rounded,
                color: kGreen,
                items: upcoming,
              ),
              ..._section(
                title: 'Expired',
                subtitle: 'Deadline has passed',
                icon: Icons.event_busy_rounded,
                color: kTextGrey,
                items: expired,
              ),
            ],
          ),
        ),
      ),
    );
  }
}

// ============================================================================
// 12. PROFILE PAGE (view + edit)
// ============================================================================

class ProfilePage extends StatefulWidget {
  final StudentProfile profile;
  final ValueChanged<StudentProfile> onSave;

  const ProfilePage({super.key, required this.profile, required this.onSave});

  @override
  State<ProfilePage> createState() => _ProfilePageState();
}

class _ProfilePageState extends State<ProfilePage> {
  bool _editing = false;

  final TextEditingController _nameCtrl = TextEditingController();
  final TextEditingController _emailCtrl = TextEditingController();
  final TextEditingController _courseCtrl = TextEditingController();
  final TextEditingController _collegeCtrl = TextEditingController();
  final TextEditingController _yearCtrl = TextEditingController();

  @override
  void initState() {
    super.initState();
    _loadControllers();
  }

  @override
  void dispose() {
    _nameCtrl.dispose();
    _emailCtrl.dispose();
    _courseCtrl.dispose();
    _collegeCtrl.dispose();
    _yearCtrl.dispose();
    super.dispose();
  }

  /// Copies the current profile into the text fields.
  void _loadControllers() {
    final p = widget.profile;
    _nameCtrl.text = p.name;
    _emailCtrl.text = p.email;
    _courseCtrl.text = p.course;
    _collegeCtrl.text = p.college;
    _yearCtrl.text = p.year;
  }

  void _message(String text) {
    ScaffoldMessenger.of(context)
      ..hideCurrentSnackBar()
      ..showSnackBar(
        SnackBar(content: Text(text), behavior: SnackBarBehavior.floating),
      );
  }

  void _save() {
    if (_nameCtrl.text.trim().isEmpty) {
      _message('Name cannot be empty');
      return;
    }
    if (!_emailCtrl.text.contains('@')) {
      _message('Please enter a valid email address');
      return;
    }
    widget.onSave(
      StudentProfile(
        name: _nameCtrl.text.trim(),
        email: _emailCtrl.text.trim(),
        course: _courseCtrl.text.trim(),
        college: _collegeCtrl.text.trim(),
        year: _yearCtrl.text.trim(),
      ),
    );
    setState(() => _editing = false);
    _message('Profile updated successfully');
  }

  Widget _field(String label, IconData icon, TextEditingController controller) {
    return Padding(
      padding: const EdgeInsets.only(bottom: 14),
      child: TextField(
        controller: controller,
        decoration: InputDecoration(
          labelText: label,
          prefixIcon: Icon(icon, color: kPurple),
          filled: true,
          fillColor: kBackground,
          border: OutlineInputBorder(
            borderRadius: BorderRadius.circular(14),
            borderSide: BorderSide.none,
          ),
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final p = widget.profile;

    return ListView(
      padding: const EdgeInsets.all(16),
      children: [
        // Header with avatar
        Container(
          padding: const EdgeInsets.all(20),
          decoration: BoxDecoration(
            gradient: const LinearGradient(
              colors: [kBlue, kPurple],
              begin: Alignment.topLeft,
              end: Alignment.bottomRight,
            ),
            borderRadius: BorderRadius.circular(24),
          ),
          child: Column(
            children: [
              CircleAvatar(
                radius: 40,
                backgroundColor: Colors.white,
                child: Text(
                  initialsOf(p.name),
                  style: const TextStyle(
                    fontSize: 28,
                    fontWeight: FontWeight.bold,
                    color: kBlue,
                  ),
                ),
              ),
              const SizedBox(height: 12),
              Text(
                p.name,
                style: const TextStyle(
                  color: Colors.white,
                  fontSize: 22,
                  fontWeight: FontWeight.bold,
                ),
              ),
              const SizedBox(height: 4),
              Text(
                '${p.course} • ${p.year}',
                textAlign: TextAlign.center,
                style: const TextStyle(color: Colors.white70),
              ),
            ],
          ),
        ),
        const SizedBox(height: 16),

        AppCard(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Row(
                children: [
                  Expanded(
                    child: Text(
                      _editing ? 'Edit Profile' : 'Student Information',
                      style: const TextStyle(
                        fontSize: 17,
                        fontWeight: FontWeight.bold,
                        color: kTextDark,
                      ),
                    ),
                  ),
                  if (!_editing)
                    TextButton.icon(
                      onPressed: () {
                        _loadControllers();
                        setState(() => _editing = true);
                      },
                      icon: const Icon(Icons.edit_rounded, size: 18),
                      label: const Text('Edit'),
                    ),
                ],
              ),
              const SizedBox(height: 8),
              if (_editing) ...[
                _field('Full name', Icons.person_rounded, _nameCtrl),
                _field('Email address', Icons.email_rounded, _emailCtrl),
                _field('Course', Icons.menu_book_rounded, _courseCtrl),
                _field('College name', Icons.apartment_rounded, _collegeCtrl),
                _field('Academic year', Icons.calendar_month_rounded, _yearCtrl),
                Row(
                  children: [
                    Expanded(
                      child: OutlinedButton(
                        onPressed: () => setState(() => _editing = false),
                        style: OutlinedButton.styleFrom(
                          minimumSize: const Size.fromHeight(48),
                          shape: RoundedRectangleBorder(
                            borderRadius: BorderRadius.circular(14),
                          ),
                        ),
                        child: const Text('Cancel'),
                      ),
                    ),
                    const SizedBox(width: 12),
                    Expanded(
                      child: FilledButton.icon(
                        onPressed: _save,
                        icon: const Icon(Icons.save_rounded),
                        label: const Text('Save'),
                        style: FilledButton.styleFrom(
                          backgroundColor: kBlue,
                          minimumSize: const Size.fromHeight(48),
                          shape: RoundedRectangleBorder(
                            borderRadius: BorderRadius.circular(14),
                          ),
                        ),
                      ),
                    ),
                  ],
                ),
              ] else ...[
                InfoRow(
                  icon: Icons.person_rounded,
                  label: 'Student name',
                  value: p.name,
                ),
                InfoRow(
                  icon: Icons.email_rounded,
                  label: 'Email address',
                  value: p.email,
                ),
                InfoRow(
                  icon: Icons.menu_book_rounded,
                  label: 'Course',
                  value: p.course,
                ),
                InfoRow(
                  icon: Icons.apartment_rounded,
                  label: 'College name',
                  value: p.college,
                ),
                InfoRow(
                  icon: Icons.calendar_month_rounded,
                  label: 'Academic year',
                  value: p.year,
                ),
              ],
            ],
          ),
        ),
      ],
    );
  }
}
